// Prisma Schema - Banco de Dados da RA Polymers (Versão Fiscal)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemUseType {
  INDUSTRIAL_INPUT
  CONSUMPTION
  RESALE
  FIXED_ASSET
}

// Modelo de Empresas (Compradora e Fornecedores)
model Fornecedor {
  id          String   @id @default(uuid())
  name        String   // Nome/Razão Social
  cnpj        String   @unique // CNPJ Único
  taxRegime   String   // SIMPLES | PRESUMIDO | REAL
  companyRole String   // SUPPLIER | BUYER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  // Relacionamento: Uma empresa pode dar várias cotações
  quotes      Quote[]
  
  // Relacionamento: Funcionários vinculados
  users       User[]

  // Premissas comerciais de TCO (se for BUYER)
  taxConfig   TaxConfiguration?
  tcoAssumptions TcoAssumption[]

  @@map("fornecedores")
}

// Modelo de Configurações Fiscais Globais/Por Comprador
// Estrutura legada mantida somente para a migração das premissas atuais.
model TaxConfiguration {
  id                    String   @id @default(uuid())
  icmsCreditPercentage  Float    @default(100.0)
  pisCreditPercentage   Float    @default(100.0)
  cofinsCreditPercentage Float   @default(100.0)
  ipiCreditPercentage   Float    @default(100.0)
  
  fornecedorId          String?  @unique
  fornecedor            Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  updatedAt             DateTime @updatedAt

  @@map("tax_configurations")
}

// Premissas comerciais usadas apenas para estimar o TCO de Compras.
model TcoAssumption {
  id                String      @id @default(uuid())
  itemUseType       ItemUseType
  icmsRecoveryPct   Float       @default(0)
  ipiRecoveryPct    Float       @default(0)
  pisRecoveryPct    Float       @default(0)
  cofinsRecoveryPct Float       @default(0)
  fornecedorId      String
  fornecedor        Fornecedor  @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  updatedAt         DateTime    @updatedAt

  @@unique([fornecedorId, itemUseType])
  @@map("tco_assumptions")
}

// Modelo de Usuários do Sistema
model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  role      String   // Cargo (Comprador, Gerente, etc)
  
  fornecedorId String
  fornecedor   Fornecedor  @relation(fields: [fornecedorId], references: [id])
  
  createdAt DateTime @default(now())
}

// Modelo da Requisição de Compra
model Requisition {
  id            String   @id @default(uuid())
  name          String   
  quantity      Float    
  unit          String   
  estimatedCost Float?   
  finalCost     Float?   
  paymentTerms  String?  
  itemUseType   ItemUseType @default(CONSUMPTION)
  requestDate   DateTime @default(now())
  deliveryDate  DateTime? 
  status        String   
  department    String   
  priority      String   
  requester     String   
  notes         String?  

  // Fluxo operacional da compra. Compras QUICK permanecem pendentes até a NF.
  purchaseMode  String   @default("STRATEGIC") // STRATEGIC | QUICK
  costReconciliationStatus String @default("NOT_REQUIRED")
  costReconciledAt DateTime?
  
  quotes        Quote[]
  purchaseInvoice PurchaseInvoice?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([purchaseMode, costReconciliationStatus])
}

// Cotação do fornecedor enriquecida com dados comerciais para estimativa de TCO.
model Quote {
  id           String      @id @default(uuid())
  supplierName String      // Nome legível do fornecedor
  price        Float       // Preço Unitário Bruto (Preço de Tabela)
  freight      Float?      @default(0)
  leadTime     Int?        @default(0)
  paymentTerms String?     
  isSelected   Boolean     @default(false)

  // --- DADOS INFORMADOS PELO FORNECEDOR ---
  itemUseType  ItemUseType @default(CONSUMPTION)
  ncm          String?
  cest         String?
  cfop         String?
  
  // ICMS
  cstIcms      String?     // CST do ICMS
  csosn        String?     // CSOSN (para Simples Nacional)
  hasIcmsSt    Boolean     @default(false)
  icmsRate     Float?
  icmsValue    Float?
  
  // PIS/COFINS
  cstPis       String?
  cstCofins    String?
  pisRate      Float?
  cofinsRate   Float?
  pisValue     Float?
  cofinsValue  Float?
  
  // IPI
  ipiRate      Float?
  ipiValue     Float?

  // IBS/CBS (transicao da Reforma Tributaria)
  cstIbsCbs    String?
  taxClassCode String?
  cbsRate      Float?      @default(0)
  cbsValue     Float?      @default(0)
  ibsRate      Float?      @default(0)
  ibsValue     Float?      @default(0)

  stRate       Float?
  stValue      Float?
  fcpRate      Float?
  fcpValue     Float?
  difalRate    Float?
  difalValue   Float?
  hasFcp       Boolean     @default(false)
  hasDifal     Boolean     @default(false)
  ipiTreatment String      @default("ADDITIONAL")
  stTreatment  String      @default("ADDITIONAL")
  fcpTreatment String      @default("ADDITIONAL")
  difalTreatment String    @default("ADDITIONAL")

  // Ajustes comerciais opcionais da premissa por cotação.
  utilizationIcms   Float?
  utilizationPis    Float?
  utilizationCofins Float?
  utilizationIpi    Float?

  // RESULTADOS CENTRALIZADOS DO SIMULADOR DE TCO
  creditIcms   Float?      @default(0)
  creditPis    Float?      @default(0)
  creditCofins Float?      @default(0)
  creditIpi    Float?      @default(0)
  netCost      Float?      @default(0) // Custo Líquido Real (TCO - Créditos)
  creditSource String?     @default("MANUAL")
  grossTotalCost        Float?
  estimatedCreditTotal Float?
  estimatedNetTotal    Float?
  dataCompleteness     String @default("INCOMPLETE")
  calculationSource    String @default("SUPPLIER_QUOTE")
  tcoMemory            Json?
  taxMemory    Json?       // Auditoria: Armazena o "porquê" do cálculo em JSON

  // Relacionamentos
  fornecedorId  String?    // Link para a empresa cadastrada
  fornecedor    Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model PurchaseInvoice {
  id                        String      @id @default(uuid())
  requisitionId             String      @unique
  requisition               Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  number                    String
  series                    String?
  accessKey                 String      @unique
  issueDate                 DateTime
  supplierCnpj              String
  importSource              String
  productTotal              Float       @default(0)
  freightTotal              Float       @default(0)
  discountTotal             Float       @default(0)
  grossTotal                Float
  icmsTotal                 Float       @default(0)
  ipiTotal                  Float       @default(0)
  pisTotal                  Float       @default(0)
  cofinsTotal               Float       @default(0)
  stTotal                   Float       @default(0)
  fcpTotal                  Float       @default(0)
  difalTotal                Float       @default(0)
  cbsTotal                  Float       @default(0)
  ibsTotal                  Float       @default(0)
  estimatedRecoverableTotal Float       @default(0)
  actualNetEstimatedTotal   Float
  quotedGrossTotal          Float
  quotedNetEstimatedTotal   Float
  quotedFreightTotal        Float
  quotedTaxTotal            Float
  actualTaxTotal            Float
  freightVariance           Float
  taxVariance               Float
  grossVariance             Float
  netVariance               Float
  xmlContent                String?     @db.Text
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}
