// Prisma Schema - Banco de Dados da RA Polymers (Versão Fiscal)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemUseType {
  INDUSTRIAL_INPUT
  CONSUMPTION
  RESALE
  FIXED_ASSET
}

enum TaxConfidenceLevel {
  ESTIMATED
  VALIDATED_BY_REGISTRATION
  VALIDATED_BY_DOCUMENT
  BLOCKED
  EXPERT_REVIEWED
}

enum TaxCalculationStatus {
  PENDING
  SUCCESS
  BLOCKED
  IN_REVIEW
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_ALL_SKIPPED
  PARTIAL
  FAILED
  CANCELED
}

enum JobItemStatus {
  PENDING
  PROCESSED
  SKIPPED
  FAILED
}

// Modelo de Empresas (Compradora e Fornecedores)
model Fornecedor {
  id              String   @id @default(uuid())
  name            String // Nome/Razão Social
  cnpj            String   @unique // CNPJ Único
  taxRegime       String // SIMPLES | PRESUMIDO | REAL
  companyRole     String // SUPPLIER | BUYER
  isActive        Boolean  @default(true)
  pisCofinsRegime String   @default("CUMULATIVE") // CUMULATIVE | NON_CUMULATIVE
  isIcmsTaxpayer  Boolean  @default(true)
  isIpiTaxpayer   Boolean  @default(false)
  state           String   @default("SP")
  tenantId        String?  // Isolamento Multi-Tenant
  createdAt       DateTime @default(now())

  // Relacionamento: Uma empresa pode dar várias cotações
  quotes Quote[]

  // Relacionamento: Funcionários vinculados
  users User[]

  @@map("fornecedores")
}

enum UserRole {
  BUYER
  MANAGER
  ADMIN
  SPECIALIST
}

// Modelo de Usuários do Sistema
model User {
  id       String   @id @default(uuid())
  name     String
  username String   @unique
  password String
  role     UserRole @default(BUYER)

  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  createdAt DateTime @default(now())
}

// Modelo da Requisição de Compra
model Requisition {
  id            String      @id @default(uuid())
  name          String
  quantity      Float
  unit          String
  estimatedCost Float?
  finalCost     Float?
  paymentTerms  String?
  itemUseType   ItemUseType @default(CONSUMPTION)
  requestDate   DateTime    @default(now())
  deliveryDate  DateTime?
  status        String
  department    String
  priority      String
  requester     String
  notes         String?

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo de Cotação de Fornecedor (Enriquecido para TCO Fiscal)
model Quote {
  id           String  @id @default(uuid())
  supplierName String // Nome legível do fornecedor
  price        Float // Preço Unitário Bruto (Preço de Tabela)
  freight      Float?  @default(0)
  leadTime     Int?    @default(0)
  paymentTerms String?
  isSelected   Boolean @default(false)

  // --- CAMPOS FISCAIS (FASE 1) ---
  itemUseType   ItemUseType @default(CONSUMPTION)
  creditNature  String      @default("OTHER") // RESALE | INSUMO | FREIGHT | ENERGY | DEPRECIATION | SERVICE | OTHER
  ncm           String?
  cfop          String?
  cest          String?
  operationType String      @default("INTERNAL") // INTERNAL | INTERSTATE
  isMonophase   Boolean?    @default(false)
  isZeroRate    Boolean?    @default(false)
  isSuspended   Boolean?    @default(false)
  isExempt      Boolean?    @default(false)

  // ICMS
  cstIcms   String? // CST do ICMS
  csosn     String? // CSOSN (para Simples Nacional)
  hasIcmsSt Boolean @default(false)
  icmsRate  Float?  @default(0)
  icmsValue Float?  @default(0)

  // PIS/COFINS
  cstPis      String?
  cstCofins   String?
  pisRate     Float?  @default(0)
  cofinsRate  Float?  @default(0)
  pisValue    Float?  @default(0)
  cofinsValue Float?  @default(0)

  // IPI
  cstIpi   String?
  ipiRate  Float?  @default(0)
  ipiValue Float?  @default(0)

  // RESULTADOS DO CÁLCULO (Motor Fiscal)
  creditIcms   Float?  @default(0)
  creditPis    Float?  @default(0)
  creditCofins Float?  @default(0)
  netCost      Float?  @default(0) // Custo Líquido Real (TCO - Créditos)
  creditSource String? @default("MANUAL")
  taxMemory    Json? // Auditoria: Armazena o "porquê" do cálculo em JSON

  // Relacionamentos
  fornecedorId String? // Link para a empresa cadastrada
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  // --- GOVERNANÇA FISCAL E AUDITORIA (FASE SAAS) ---
  taxConfidenceLevel   TaxConfidenceLevel   @default(ESTIMATED)
  taxCalculationStatus TaxCalculationStatus @default(PENDING)
  lastTaxSnapshotId    String?
  lastTaxCalculatedAt  DateTime?
  lastTaxEngineVersion String?

  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  taxSnapshots QuoteTaxSnapshot[]
  reviewQueue  TaxReviewQueueItem[]

  pendingReview Boolean @default(false) // Flag rápida: quote tem item aberto na fila de revisão

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo de Snapshot Fiscal Auditável
model QuoteTaxSnapshot {
  id            String   @id @default(uuid())
  quoteId       String
  engineVersion String
  calculatedAt  DateTime @default(now())

  // --- TRILHA DE AUDITORIA & HASH (FASE 2) ---
  inputJson         Json
  inputHash         String
  hashAlgorithm     String   @default("SHA-256")
  hashSchemaVersion String   @default("1.0")

  grossCostUnit  Float
  grossCostTotal Float
  netCostUnit    Float
  netCostTotal   Float

  icmsCredit   Float
  pisCredit    Float
  cofinsCredit Float
  ipiCredit    Float

  confidenceLevel     TaxConfidenceLevel   @default(ESTIMATED)
  calculationStatus   TaxCalculationStatus @default(PENDING)
  decisionSummaryJson Json?
  ruleCodesJson       Json?
  legalBasisJson      Json
  memoryJson          Json

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_tax_snapshots")
}

model TaxRuleCatalog {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String?  // ICMS | PIS | COFINS | IPI | GENERAL
  severity    String?  // BLOCKING | WARNING | INFO
  appliesTo   Json?    // Condições de aplicação (ex: { taxRegime: "REAL", itemUseType: "INDUSTRIAL_INPUT" })
  version     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions   TaxReviewDecision[] @relation("DecisionRules")
}

// === FASE 5 — BASE LEGAL PADRONIZADA ===

model TaxLegalBasis {
  id          String   @id @default(uuid())
  code        String   @unique  // Ex: "CFEB_ART155", "LC123_ART23"
  name        String   // Ex: "CFEB Art. 155 - ICMS"
  lawType     String   // CFEB | LC | DECREASE | PORTARIA | CONVENIO | NOTA_TECNICA
  lawNumber   String?  // Número da lei (ex: "123/2006")
  article     String?  // Artigo específico
  paragraph   String?  // Parágrafo/inciso
  description String
  url         String?  // Link para texto oficial
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("tax_legal_basis")
}

// --- REPROCESSAMENTO EM MASSA (FASE 3) ---

model TaxReprocessingJob {
  id                String    @id @default(uuid())
  tenantId          String    // Obrigatório para isolamento Multi-Tenant
  requestedByUserId String    // Auditoria (Quem disparou) - vindo do contexto auth
  buyerCompanyId    String    // Comprador associado a este job (resolvido na criação)

  scopeType         String    // "QUOTE" | "COMPANY" | "DATE_RANGE" | "ENGINE_VERSION" | "TENANT_ALL"
  scopePayloadJson  Json      // Parâmetros do Escopo (Ex: { companyId: "xyz" })
  reason            String    // Obrigatório na criação

  engineVersionFrom String?
  engineVersionTo   String?

  status            JobStatus @default(QUEUED)

  totalItems        Int       @default(0)
  processedItems    Int       @default(0)
  skippedItems      Int       @default(0)
  failedItems       Int       @default(0)

  cancelRequestedAt DateTime? // Para cancelamento cooperativo
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)

  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?

  items             TaxReprocessingJobItem[]

  @@map("tax_reprocessing_jobs")
}

model TaxReprocessingJobItem {
  id              String         @id @default(uuid())
  jobId           String
  quoteId         String

  oldSnapshotId   String?
  newSnapshotId   String?

  oldInputHash    String?
  newInputHash    String?

  status          JobItemStatus  @default(PENDING)
  skipReason      String?        // Ex: INPUT_HASH_UNCHANGED
  errorMessage    String?

  retryCount      Int            @default(0)
  maxRetries      Int            @default(3)

  startedAt       DateTime?
  finishedAt      DateTime?

  job             TaxReprocessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("tax_reprocessing_job_items")
}

// === FASE 4 — REVISÃO ESPECIALIZADA ===

enum ReviewStatus {
  OPEN
  ASSIGNED
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReviewOutcome {
  CALCULATION_ACCEPTED      // Especialista validou o cálculo automático
  CALCULATION_ADJUSTED      // Especialista ajustou manualmente os valores
  CALCULATION_REJECTED      // Especialista rejeitou e marcou como manual
  ESCALATED                 // Encaminhado para nível superior
}

model TaxReviewQueueItem {
  id                String        @id @default(uuid())
  tenantId          String        // Isolamento multi-tenant
  quoteId           String        // Cotação em revisão
  reason            String        // Motivo da abertura automática (ex: LOW_CONFIDENCE, BLOCKED, HIGH_TAX_DELTA)
  severity          ReviewSeverity @default(MEDIUM)

  status            ReviewStatus  @default(OPEN)
  assignedToUserId  String?       // Especialista responsável
  resolvedByUserId  String?       // Quem resolveu

  oldSnapshotId     String?       // Snapshot que gerou a revisão
  newSnapshotId     String?       // Snapshot recalculado (se houver)

  notes             String?       // Notas do especialista
  resolutionNotes   String?       // Explicação da decisão

  createdAt         DateTime      @default(now())
  assignedAt        DateTime?
  resolvedAt        DateTime?

  quote             Quote          @relation(fields: [quoteId], references: [id])
  decisions         TaxReviewDecision[]

  @@index([tenantId, status])
  @@index([assignedToUserId, status])
  @@map("tax_review_queue_items")
}

enum ReviewSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TaxReviewDecision {
  id                String          @id @default(uuid())
  reviewItemId      String
  tenantId          String

  outcome           ReviewOutcome
  adjustedValues    Json?           // Valores ajustados pelo especialista (se applicable)
  explanation       String?         // Explicação do especialista
  ruleCodes         String[]        // Códigos de regra aplicados
  legalBasisRef     String?         // Base legal citada

  createdAt         DateTime        @default(now())
  createdByUserId   String

  reviewItem        TaxReviewQueueItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  appliedRules      TaxRuleCatalog[]  @relation("DecisionRules")

  @@map("tax_review_decisions")
}
